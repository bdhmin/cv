<!doctype html>
<html lang="en" data-marble="1">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="marble:capabilities" content="storage; net=none">
<title>Bryan Min — CV</title>
<style>
  /* The page this document is really for. Everything on screen is a preview of
     it, so the print rules are the ones that decide the layout and the screen
     rules only add the desk it sits on. */
  @page { size: letter; margin: 0.75in; }

  :root {
    --ink: #000;
    --rule: #000;
    --desk: #f1f1f2;
    /* The gutter holding "2026 [C7]". Measured off the source document: the
       body column there starts 0.98in in from the text edge. */
    --gutter: 0.86in;
    --indent: 0.28in;
    --gap: 0.12in;
    --rail: 13.5rem;

    /* Hover, as a system rather than a value picked per control.
       Everything interactive settles through the same tint at the same speed,
       and the tints are deliberately shallow — a rail beside a document should
       answer the pointer, not compete with the page for attention. Leaving is
       slower than arriving, which is what makes it read as settling rather
       than blinking. */
    --tint-1: rgba(17, 17, 20, .04);   /* hover */
    --tint-2: rgba(17, 17, 20, .07);   /* held, or chosen */
    --edge:   rgba(17, 17, 20, .10);
    --ink-1:  rgba(17, 17, 20, .58);   /* resting label */
    --ink-2:  rgba(17, 17, 20, .78);   /* hovered */
    --ink-3:  rgba(17, 17, 20, .92);   /* chosen */
    --ease: cubic-bezier(.32, .72, 0, 1);
    --in: .13s;
    --out: .22s;
    /* Where margin furniture starts. The drag handle is the anchor, so a
       grip and a + button share a left edge and the margin reads as one
       column. */
    --lane: -2.45rem;
  }

  * { box-sizing: border-box; }

  html { background: var(--desk); }

  body {
    margin: 0;
    color: var(--ink);
    /* Only the desk. The sheet sets its own type, because the typeface is a
       property of the document rather than of the window it is shown in. */
    font: 10pt/1.34 system-ui, sans-serif;
    padding-left: var(--rail);
    -webkit-font-smoothing: antialiased;
  }

  .sheet {
    width: 8.5in;
    min-height: 11in;
    margin: 1.5rem auto 4rem;
    padding: 0.75in;
    background: #fff;
    box-shadow: 0 1px 2px rgba(0, 0, 0, .10), 0 8px 30px rgba(0, 0, 0, .09);
  }

  /* ---- type ----

     Which face the CV is set in is one attribute on the sheet, and every rule
     below reads it. So switching is a single setAttr, the choice survives in
     the bytes, and the file opened with no host at all comes up in the face it
     was left on rather than a default someone has to re-pick.

     Every face is a local one. Fetching a webfont would make the document need
     the network to look like itself, which for a CV is the wrong trade.

     Each carries its own size and tracking because they do not set to the same
     width or x-height, and a CV that reflows to five pages because you changed
     the font has not really given you a choice. Sizes are em-based from here
     down, so the whole hierarchy scales with the pick. */

  /* Each stack is named once here, because two things need it: the sheet, and
     the swatch in the rail that has to be set in the face it is offering. A
     second copy in the rail would be the same fact written twice. */
  :root {
    --face-source:    "Source Sans 3", "Helvetica Neue", sans-serif;
    --face-avenir:    "Avenir Next", Avenir, sans-serif;
    --face-optima:    Optima, "Helvetica Neue", sans-serif;
    --face-helvetica: "Helvetica Neue", Helvetica, Arial, sans-serif;
    --face-charter:   Charter, Georgia, serif;
    --face-newyork:   "New York", ui-serif, Georgia, serif;
    --face-hoefler:   "Hoefler Text", Palatino, serif;
  }

  .sheet {
    /* The default, and the fallback if the attribute names a face this
       document does not know — it still has to look deliberate. */
    --face: var(--face-source);
    --fsize: 10.4pt;
    --track: 0;
    --leading: 1.34;

    font-family: var(--face);
    font-size: var(--fsize);
    letter-spacing: var(--track);
    line-height: var(--leading);
  }

  /* sans */
  .sheet[data-font="source"]    { --face: var(--face-source);    --fsize: 10.4pt; --track: 0;       --leading: 1.34; }
  .sheet[data-font="avenir"]    { --face: var(--face-avenir);    --fsize: 9.9pt;  --track: -.004em; --leading: 1.35; }
  .sheet[data-font="optima"]    { --face: var(--face-optima);    --fsize: 10.6pt; --track: 0;       --leading: 1.33; }
  .sheet[data-font="helvetica"] { --face: var(--face-helvetica); --fsize: 10pt;   --track: -.006em; --leading: 1.34; }

  /* serif */
  .sheet[data-font="charter"]   { --face: var(--face-charter);   --fsize: 10.1pt; --track: -.003em; --leading: 1.33; }
  .sheet[data-font="newyork"]   { --face: var(--face-newyork);   --fsize: 10.4pt; --track: 0;       --leading: 1.33; }
  .sheet[data-font="hoefler"]   { --face: var(--face-hoefler);   --fsize: 10.9pt; --track: 0;       --leading: 1.31; }

  /* ---- masthead ---- */

  .masthead {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.4in;
    margin-bottom: 6pt;
  }
  .name {
    margin: 0;
    font-size: 2.3em;
    font-weight: 400;
    line-height: 1.1;
    letter-spacing: -.005em;
  }
  .contact { text-align: right; line-height: 1.5; }
  .contact div { white-space: nowrap; }

  /* ---- sections ---- */

  h2.sec {
    margin: 15pt 0 5pt;
    padding-bottom: 1pt;
    border-bottom: 1px solid var(--rule);
    font-size: 1.35em;
    font-weight: 400;
    line-height: 1.25;
    text-transform: uppercase;
  }
  h3.sub {
    margin: 8pt 0 3pt;
    font-size: 1.06em;
    font-weight: 700;
  }

  /* A left-hand label with a right-aligned date or place opposite it. The two
     halves are separate elements because they are separately editable. */
  .row {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.25in;
  }
  .row > .r { text-align: right; white-space: nowrap; }
  .row.strong > * { font-weight: 700; }
  .indent { margin-left: var(--indent); }

  /* ---- publications ---- */

  .pub {
    display: grid;
    grid-template-columns: var(--gutter) 1fr;
    column-gap: var(--gap);
    margin-bottom: 7pt;
  }
  .pub > .key { text-align: right; white-space: nowrap; }
  .pub > .body > * { margin: 0; }
  .pub .title { font-weight: 700; }
  .pub .venue { font-style: italic; }
  .pub .award { }

  /* ---- experience, talks ---- */

  .entry { margin-bottom: 7pt; }
  .entry .org { font-weight: 700; }
  .entry .talk { font-style: italic; }

  .lines > .row { margin-bottom: 1pt; }

  /* ---- the bits that are the app rather than the document ---- */

  /* The rail. Fixed to the left edge and pushed off the paper by a body
     padding, so the sheet still centres in whatever is left rather than
     sliding under it. */
  .rail {
    position: fixed;
    left: 0; top: 0; bottom: 0;
    z-index: 50;
    width: var(--rail);
    padding: 1.1rem .85rem;
    overflow-y: auto;
    border-right: 1px solid rgba(0, 0, 0, .09);
    background: #fbfbfc;
    font: 12px/1.4 system-ui, sans-serif;
    color: #111;
  }
  .rail-group + .rail-group { margin-top: 1.3rem; }
  .rail-title {
    margin: 0 0 .45rem;
    font-size: 10px;
    font-weight: 600;
    letter-spacing: .07em;
    text-transform: uppercase;
    color: rgba(0, 0, 0, .4);
  }
  .rail-note {
    margin: .5rem 0 0;
    font-size: 10.5px;
    line-height: 1.45;
    color: rgba(0, 0, 0, .38);
  }

  /* A grip hangs off its item's left edge, which works in a page with a margin
     and not at all in a rail pinned to the window. In here they turn inward. */
  .rail .marble-grip {
    left: auto;
    right: .25rem;
  }
  /* The rail's own groups reorder too, so Export can sit above Typeface. Its
     grip rides at the top, level with the group's label. */
  .rail > .rail-group > .marble-grip { top: .05rem; }
  .rail-group.marble-dragging { opacity: .4; }

  .faces { margin: 0; padding: 0; list-style: none; display: grid; gap: 2px; }
  .faces > li > .marble-grip { top: 50%; transform: translateY(-50%); }
  /* The swatch's own tint already reads as "this row is live", so the knobs sit
     straight on it. They used to carry an opaque plate, which was only ever
     there to survive the black chosen-state and showed up as a pale rectangle
     floating inside the row once that went away. */
  .faces .marble-btn { opacity: .5; }
  .faces li:hover .marble-btn { opacity: .85; }
  .faces .marble-btn:hover { opacity: 1; }
  .faces button {
    display: block;
    width: 100%;
    padding: .4rem .5rem;
    border: 1px solid transparent;
    border-radius: 6px;
    background: none;
    color: var(--ink-2);
    text-align: left;
    cursor: pointer;
    transition:
      background-color var(--out) var(--ease),
      border-color var(--out) var(--ease),
      color var(--out) var(--ease);
  }
  .faces button:hover {
    background: var(--tint-1);
    color: var(--ink-3);
    transition-duration: var(--in);
  }
  .faces button:focus-visible { outline: 2px solid #5b8def; outline-offset: -1px; }
  /* The swatch is set in the face it is offering — that is the preview. */
  .faces .fname { display: block; font-size: 14px; line-height: 1.25; }
  .faces .fnote {
    display: block;
    font: 10px/1.3 system-ui, sans-serif;
    color: rgba(0, 0, 0, .4);
    letter-spacing: .02em;
  }
  .faces [data-face="source"]    .fname { font-family: var(--face-source); }
  .faces [data-face="avenir"]    .fname { font-family: var(--face-avenir); }
  .faces [data-face="optima"]    .fname { font-family: var(--face-optima); }
  .faces [data-face="helvetica"] .fname { font-family: var(--face-helvetica); }
  .faces [data-face="charter"]   .fname { font-family: var(--face-charter); }
  .faces [data-face="newyork"]   .fname { font-family: var(--face-newyork); }
  .faces [data-face="hoefler"]   .fname { font-family: var(--face-hoefler); }

  /* Which one is on cannot be a CSS match — it means "the child whose value
     equals the sheet's attribute", and a selector cannot ask that. So a script
     derives it into a marble- class, and a static default covers the case where
     there is no host to derive anything. */
  /* Chosen is a settled tint and a visible edge, not a black plate. Reversing
     to white-on-black made the one thing you had already decided shout louder
     than the six you had not. */
  .faces .marble-on,
  .faces:not(.marble-derived) [data-face="source"] {
    background: var(--tint-2);
    border-color: rgba(17, 17, 20, .17);
  }
  .faces .marble-on .fname,
  .faces:not(.marble-derived) [data-face="source"] .fname { color: var(--ink-3); }
  .faces .marble-on .fnote,
  .faces:not(.marble-derived) [data-face="source"] .fnote { color: rgba(17, 17, 20, .5); }

  .outline { margin: 0; padding: 0; list-style: none; display: grid; gap: 1px; }
  .outline li {
    display: flex;
    align-items: center;
    gap: .3rem;
    padding: .26rem .4rem .26rem .3rem;
    border: 1px solid transparent;
    border-radius: 5px;
    color: var(--ink-1);
    cursor: grab;
    user-select: none;
    transition:
      background-color var(--out) var(--ease),
      border-color var(--out) var(--ease),
      color var(--out) var(--ease),
      opacity var(--out) var(--ease);
  }
  .outline li:hover {
    background: var(--tint-1);
    color: var(--ink-3);
    transition-duration: var(--in);
  }
  .outline li.marble-dragging { opacity: .35; }
  /* The drop line is the one place a firmer edge earns itself — it has to be
     unmistakable mid-drag — but it is still ink rather than pure black. */
  .outline li.marble-over { border-top-color: rgba(17, 17, 20, .55); }
  .outline li.marble-over-after { border-bottom-color: rgba(17, 17, 20, .55); }
  .outline .dot {
    flex: none;
    color: rgba(17, 17, 20, .22);
    font: 11px/1 ui-monospace, SFMono-Regular, Menlo, monospace;
    transition: color var(--out) var(--ease);
  }
  .outline li:hover .dot { color: rgba(17, 17, 20, .42); }
  .outline .oname { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

  /* A hidden section keeps its row, or there would be no way back. */
  .outline li.marble-off .oname { color: rgba(17, 17, 20, .34); text-decoration: line-through; }
  .outline .eye {
    flex: none;
    margin-left: auto;
    display: grid;
    place-items: center;
    width: 1.15rem;
    height: 1.15rem;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: rgba(17, 17, 20, .28);
    cursor: pointer;
    opacity: 0;
    transition:
      opacity var(--out) var(--ease),
      color var(--out) var(--ease),
      background-color var(--out) var(--ease);
  }
  .outline li:hover .eye,
  .outline li.marble-off .eye,
  .outline .eye:focus-visible { opacity: 1; transition-duration: var(--in); }
  .outline .eye:hover { color: var(--ink-2); background: var(--tint-2); }
  .outline .eye svg { width: 13px; height: 13px; display: block; }

  .rail .print {
    width: 100%;
    padding: .48rem .8rem;
    border: 1px solid rgba(0, 0, 0, .16);
    border-radius: 7px;
    background: #fff;
    color: #111;
    font: 500 12px/1 system-ui, sans-serif;
    box-shadow: 0 1px 2px rgba(0, 0, 0, .05);
    cursor: pointer;
    transition:
      background-color var(--out) var(--ease),
      border-color var(--out) var(--ease),
      box-shadow var(--out) var(--ease);
  }
  .rail .print:hover {
    background: #fafafb;
    border-color: rgba(17, 17, 20, .24);
    box-shadow: 0 1px 3px rgba(0, 0, 0, .08);
    transition-duration: var(--in);
  }

  /* A heading and the button that adds to what follows it. The button is out in
     the left margin, so the heading keeps the text edge to itself. */
  .head-row { position: relative; }
  /* Same lane and the same right edge as a grip, so the margin reads as one
     column of controls rather than three things that happen to be left of the
     text. `right: 100%` measures from the content edge, which is what every
     other piece of furniture is measured from too. */
  .add {
    position: absolute;
    left: var(--lane);
    top: .12em;
    display: grid;
    place-items: center;
    width: 1rem;
    height: 1.15rem;
    padding: 0;
    border: 0;
    border-radius: 4px;
    background: none;
    color: rgba(0, 0, 0, .3);
    font: 400 15px/1 system-ui, sans-serif;
    cursor: pointer;
    transition:
      color var(--out) var(--ease),
      background-color var(--out) var(--ease);
  }
  /* Legible on its own, but it belongs to the heading it sits beside, so it
     only comes fully forward when you are actually there. */
  .sec-block:hover .add { color: rgba(17, 17, 20, .42); }
  .add:hover {
    color: var(--ink-2);
    background: var(--tint-2);
    transition-duration: var(--in);
  }
  .add:focus-visible { outline: 2px solid #5b8def; outline-offset: 1px; }

  /* Printing is the point of the document, so anything belonging to the editor
     leaves — and the sheet stops being a sheet, because @page owns the margins
     once there is a real page under it. */
  @media print {
    html { background: #fff; }
    .sheet {
      width: auto;
      min-height: 0;
      margin: 0;
      padding: 0;
      box-shadow: none;
    }
    body { padding-left: 0; }
    .rail, .add { display: none !important; }
    .pub, .entry { break-inside: avoid; }
    h2.sec, h3.sub { break-after: avoid; }
  }
</style>
</head>
<body>

<aside class="rail" data-marble-id="rail" data-marble-sortable="rail">





  <div class="rail-group" data-marble-id="rg-out">
    <h2 class="rail-title" data-marble-id="rt-out" data-marble-editable>Export</h2>
    <button class="print" data-marble-id="bar-pdf" type="button">Download PDF</button>
    <p class="rail-note" data-marble-id="rn-out" data-marble-editable>In the print dialog, untick “Headers and footers”.</p>
  </div>
  <div class="rail-group" data-marble-id="rg-face">
    <h2 class="rail-title" data-marble-id="rt-face" data-marble-editable>Typeface</h2>
    <ul class="faces" data-marble-id="faces" data-marble-sortable="faces">
      <li data-marble-id="li-source" data-marble-removable><button type="button" data-marble-id="f-source" data-face="source"><span class="fname" data-marble-id="fn-source">Source Sans 3</span><span class="fnote" data-marble-id="fd-source">Humanist sans </span></button></li>
      <li data-marble-id="li-charter" data-marble-removable><button type="button" data-marble-id="f-charter" data-face="charter"><span class="fname" data-marble-id="fn-charter">Charter</span><span class="fnote" data-marble-id="fd-charter">Transitional serif</span></button></li>
      <li data-marble-id="li-newyork" data-marble-removable><button type="button" data-marble-id="f-newyork" data-face="newyork"><span class="fname" data-marble-id="fn-newyork">New York</span><span class="fnote" data-marble-id="fd-newyork">Modern serif</span></button></li>
    </ul>
    <p class="rail-note" data-marble-id="rn-face" data-marble-editable>Hover to try one on the page. Click to keep it.</p>
  </div>
  <div class="rail-group" data-marble-id="rg-outline">
    <h2 class="rail-title" data-marble-id="rt-outline" data-marble-editable>Sections</h2>
    <!-- Filled from the document. The names and their order are already in the
         sheet, so writing them here too would be the same fact twice, and the
         copy would be the one that went stale. -->
    <ol class="outline" data-marble-id="outline"></ol>
    <p class="rail-note" data-marble-id="rn-outline" data-marble-editable>Drag to reorder the CV. Click to jump.</p>
  </div>

</aside>

<main class="sheet" data-marble-id="sheet" data-font="charter">

  <header class="masthead" data-marble-id="masthead">
    <h1 class="name" data-marble-id="name" data-marble-editable>Bryan Min</h1>
    <div class="contact" data-marble-id="contact">
      <div data-marble-id="email" data-marble-editable>bdmin@ucsd.edu</div>
      <div data-marble-id="site" data-marble-editable>bryanmin.me</div>
    </div>
  </header>
  <!-- The sections, as elements. Dragging one in the rail outline files a
       move against the section it names, which is why each is one node. -->
  <!-- Not sortable in the page. A section's grip would land in the same strip
       of margin as the + button of the heading inside it, and hovering one
       publication lit up two grips at once — its own and its section's. The
       rail outline is the better gesture for something two pages long, so
       sections are moved from there and the margin belongs to the entries. -->
  <div class="doc" data-marble-id="doc">


  <section class="sec-block" data-marble-id="blk-edu" aria-label="Education">
    <!-- ================= EDUCATION ================= -->

    <h2 class="sec" data-marble-id="s-edu" data-marble-editable>Education</h2>

    <div data-marble-id="edu-list" data-marble-sortable="edu">
      <div class="entry" data-marble-id="edu-ucsd" data-marble-removable>
        <div class="org" data-marble-id="edu-ucsd-org" data-marble-editable>University of California San Diego</div>
        <div class="row indent" data-marble-id="edu-phd">
          <span data-marble-id="edu-phd-l" data-marble-editable>Ph.D. in Cognitive Science. Advisor: Haijun Xia</span>
          <span class="r" data-marble-id="edu-phd-r" data-marble-editable>Expected June 2029</span>
        </div>
        <div class="row indent" data-marble-id="edu-bs">
          <span data-marble-id="edu-bs-l" data-marble-editable>B.S. in Computer Science (Magna Cum Laude)</span>
          <span class="r" data-marble-id="edu-bs-r" data-marble-editable>June 2023</span>
        </div>
      </div>
    </div>
  </section>
  <section class="sec-block" data-marble-id="blk-pub" aria-label="Publications">
    <!-- ================= PUBLICATIONS ================= -->

    <h2 class="sec" data-marble-id="s-pub" data-marble-editable>Publications</h2>

    <div class="head-row" data-marble-id="hr-h-conf">
      <button class="add" data-marble-id="add-conf" type="button" data-cv-form="pub" data-marble-add="#tpl-pub" data-marble-into="next" data-cv-prefix="C">+</button>
      <h3 class="sub" data-marble-id="h-conf" data-marble-editable>Conference Papers</h3>
    </div>
    <div data-marble-id="conf" data-marble-sortable="pubs">

      <div class="pub" data-marble-id="c7" data-marble-removable>
        <div class="key" data-marble-id="c7-k" data-marble-editable>2026 [C7]</div>
        <div class="body" data-marble-id="c7-b">
          <p class="title" data-marble-id="c7-t" data-marble-editable>Maru: Information Architecture as a Shared Language for Generating Aligned and Persistent User Interfaces</p>
          <p class="authors" data-marble-id="c7-a"><span data-marble-id="c7-a1" data-marble-editable>Eunhye Kim, DaEun Choi, </span><strong data-marble-id="c7-me" data-marble-editable>Bryan Min</strong><span data-marble-id="c7-a2" data-marble-editable>, Hyunjung Yi, Yue Jiang, Juho Kim</span></p>
          <p class="venue" data-marble-id="c7-v" data-marble-editable>UIST 2026: Proceedings of the 2025 ACM Symposium on User Interface Software and Technology</p>
        </div>
      </div>

      <div class="pub" data-marble-id="c6" data-marble-removable>
        <div class="key" data-marble-id="c6-k" data-marble-editable>2026 [C6]</div>
        <div class="body" data-marble-id="c6-b">
